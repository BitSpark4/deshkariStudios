# Contact form uses Netlify Forms — no API keys required.
# After deploying to Netlify, configure email notification in:
#   Netlify Dashboard → Forms → Settings → Form notifications → Add Email notification
#   - Email to notify: team@deshkaristudios.com
#   - Form: contact

# Optional — only used if you switch the Contact map from iframe embed
# to the full Google Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=your_maps_key_here
