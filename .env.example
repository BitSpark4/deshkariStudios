# EmailJS — sign up at https://www.emailjs.com/ and paste keys here.
# Used by the Contact page form. Without these, form submission will fail at runtime.
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Optional: used for the Contact page map embed if you switch from iframe to JS API.
VITE_GOOGLE_MAPS_API_KEY=your_maps_key_here
